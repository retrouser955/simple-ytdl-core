{
  "name": "simple-ytdl-core",
  "version": "1.1.1",
  "description": "A simple YouTube downloader. Used by discord-player-youtubei to stream from YouTube.",
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "bgutils-js": "^4.0.3",
    "googlevideo": "^4.1.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "youtubei.js": "^18.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "jsdom": "29.0.1"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "author": {
    "name": "retro_ig"
  }
}
